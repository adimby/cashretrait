{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "jsx": "react-jsx", "jsxImportSource": "preact",
    "skipLibCheck": true, "noEmit": true, "resolveJsonModule": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "api", "tests", "scripts", "vite.config.ts", "vitest.config.ts", "pwa.config.ts"]
}
